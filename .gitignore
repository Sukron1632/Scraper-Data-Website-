# ==========================================
# 1. Environment & Sensitive Credentials
# ==========================================
.env
.env.*
!.env.example
storage/sessions/*.json
!storage/sessions/.gitkeep

# ==========================================
# 2. Dependencies & Build Tools
# ==========================================
node_modules/
.codegraph/
!.codegraph/.gitignore
.playwright/

# ==========================================
# 3. Python & Node Caches / Logs
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# 4. Storage (Keep directory structures, ignore all data)
# ==========================================
storage/**
!storage/**/
!storage/**/.gitkeep

# ==========================================
# 5. Output (Keep directory structures, ignore all data)
# ==========================================
output/**
!output/**/
!output/**/.gitkeep

# ==========================================
# 6. References (Keep directory structures, ignore all data)
# ==========================================
references/**
!references/**/
!references/**/.gitkeep

# ==========================================
# 7. Archives, Temporary & Diagnostic Dumps
# ==========================================
*.zip
*.tar.gz
*.tgz
*.rar
*.7z
*.sha256
temp_check/
temp*/
tmp/

# ==========================================
# 8. Operating System & Editor Files
# ==========================================
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.idea/
*.sublime-project
*.sublime-workspace
