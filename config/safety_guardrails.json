{
  "description": "Strict Read-Only Safety Guardrails to protect live production systems from any data modifications or disruptive actions.",
  "strictMode": true,
  "blockedHttpMethods": [
    "POST",
    "PUT",
    "DELETE",
    "PATCH"
  ],
  "allowedAuthEndpoints": [
    "/login",
    "/signin",
    "/auth",
    "/api/login",
    "/api/auth/callback"
  ],
  "forbiddenActionKeywords": [
    "simpan",
    "save",
    "submit",
    "hapus",
    "delete",
    "destroy",
    "remove",
    "ubah",
    "edit",
    "update",
    "bayar",
    "pay",
    "checkout",
    "proses",
    "process",
    "batal",
    "cancel transaksi",
    "tambah",
    "tambah data",
    "create",
    "insert",
    "add new",
    "post",
    "confirm",
    "konfirmasi transaksi",
    "kirim",
    "send",
    "terapkan",
    "apply",
    "eksekusi",
    "execute",
    "reset data",
    "truncate",
    "drop"
  ],
  "forbiddenUrlPatterns": [
    "/delete",
    "/destroy",
    "/remove",
    "/edit",
    "/update",
    "/save",
    "/create",
    "/new",
    "action=delete",
    "action=destroy",
    "action=update",
    "action=save"
  ],
  "forbiddenElementSelectors": [
    "button[type='submit']",
    "input[type='submit']",
    "button.btn-danger",
    "button.btn-destructive",
    "a.btn-danger",
    "[data-action*='delete']",
    "[data-action*='save']",
    "[data-action*='submit']",
    "[data-action*='edit']"
  ],
  "allowedNavigationPatterns": [
    "a[href]",
    "button.nav-link",
    "button[role='tab']",
    "ul.pagination li a",
    ".sidebar-item a",
    ".menu-item a",
    ".navbar a",
    "button[aria-label*='Next']",
    "button[aria-label*='Previous']",
    "button.btn-info",
    "a.btn-info",
    "[data-action*='detail']",
    "[data-action*='view']"
  ],
  "browserScriptInjections": {
    "disableForms": true,
    "makeInputsReadonly": true,
    "interceptSubmit": true
  }
}

