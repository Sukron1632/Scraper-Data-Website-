# ==============================================================================
# ENVIRONMENT CONFIGURATION - GUIDEBOOK CRAWLER & DUAL GEMINI ORCHESTRATOR
# ==============================================================================

# Target Operational System URL (Sistem yang sedang berjalan)
BASE_URL=https://sistem-operasional.internal.example.com

# ------------------------------------------------------------------------------
# DUAL GEMINI API TOKENS ORCHESTRATION (3.8 Flash High Accuracy Mode)
# ------------------------------------------------------------------------------
# Token 1: Explorer & Vision Analyst (Analisis UI, DOM, dan Screenshot)
GEMINI_API_KEY_1=AIzaSy_YOUR_FIRST_GEMINI_KEY_HERE

# Token 2: SOP Synthesizer, Cross-Auditor & Automatic Fallback
GEMINI_API_KEY_2=AIzaSy_YOUR_SECOND_GEMINI_KEY_HERE

# Gemini Model Identifier (Default: gemini-2.5-flash / gemini-3.8-flash)
GEMINI_MODEL=gemini-2.5-flash

# Model Temperature (0.1 - 0.3 untuk akurasi tinggi dan deterministik)
GEMINI_TEMPERATURE=0.2

# ------------------------------------------------------------------------------
# MULTI-ROLE CREDENTIALS (IT ADMIN & REGULAR EMPLOYEES)
# ------------------------------------------------------------------------------
# Akun IT Team (Untuk melihat menu teknis / konfigurasi jika diperlukan)
AUTH_IT_USERNAME=it_support
AUTH_IT_PASSWORD=it_password_here
AUTH_IT_ROLE="IT Administrator"

# Akun Karyawan Biasa / Staff Operasional (Fokus utama perspektif Guidebook)
AUTH_EMPLOYEE_USERNAME=staff_operasional
AUTH_EMPLOYEE_PASSWORD=staff_password_here
AUTH_EMPLOYEE_ROLE="Karyawan Operasional"

# Akun Supervisor / Manager (Opsional)
AUTH_MANAGER_USERNAME=
AUTH_MANAGER_PASSWORD=
AUTH_MANAGER_ROLE="Supervisor"

# Active Role to Crawl With: 'employee' (default), 'it', or 'both'
ACTIVE_CRAWL_ROLE=employee

# ------------------------------------------------------------------------------
# SAFETY GUARDRAILS (STRICT READ-ONLY - NO DATA MUTATION)
# ------------------------------------------------------------------------------
# SAFE_MODE: true = Mencegah segala bentuk POST/PUT/DELETE, submit form, dan klik tombol ubah/hapus
SAFE_MODE=true

# Allow Login POST only (Hanya mengizinkan POST pada URL login awal agar bisa masuk)
ALLOW_AUTH_POST=true

# ------------------------------------------------------------------------------
# SERVER LOAD THROTTLING (AGAR TIDAK MEMBEBANI SERVER OPERASIONAL)
# ------------------------------------------------------------------------------
# Jeda antar navigasi / request halaman dalam milidetik (Rekomendasi: 2000 - 4000 ms)
RATE_LIMIT_DELAY_MS=2500

# Concurrency crawler (Wajib 1 pada server live harian)
CRAWLER_CONCURRENCY=1

# Batas maksimal halaman yang dicrawl per sesi
MAX_PAGES_LIMIT=60

# Kedalaman crawl (crawl depth)
MAX_DEPTH=3

# Headless browser mode (true = tanpa jendela GUI, false = tampilkan jendela browser Chromium)
BROWSER_HEADLESS=true

